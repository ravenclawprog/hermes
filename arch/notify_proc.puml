@startuml
autonumber

participant "Kafka" as Broker
box "Notification Service" #LightYellow
participant "Kafka Consumer" as Consumer
participant "WebSocket Manager" as WSMan
database "Redis (Pub/Sub)" as Redis
end box
participant "hermes-cli (User B)" as CLIB

CLIB -> WSMan : WebSocket Connection Established
activate WSMan
WSMan -> WSMan : Register connection in sync.Map (UserB -> Connection)

... somebody changed data ...

Broker -> Consumer : Poll Event: DOC_UPDATED (DocID=42, Author=UserA)
activate Consumer

Consumer -> Redis : Publish to channel "doc_events" (Payload)
note over Redis: Redis dispatch events\nbetween independent pods K8s

Redis -> WSMan : Pub/Sub Trigger (Event Data)
WSMan -> WSMan : Look up active session for UserB

WSMan -> CLIB : WS Message: BroadcastEvent (Type: "DOC_UPDATED", Body)
activate CLIB
CLIB -> CLIB : Process incoming event via Go-channel
CLIB -> CLIB : Print notification to user background stream
deactivate CLIB

deactivate Consumer
@enduml
